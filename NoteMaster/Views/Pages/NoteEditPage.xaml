<Page x:Class="NoteMaster.Views.Pages.NoteEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="NoteEditPage">

    <!-- 页面资源定义 -->
    <Page.Resources>
        <!-- 布尔值到可见性的转换器，用于控制删除按钮的显示/隐藏 -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- 标签样式 -->
        <Style x:Key="TagChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F7FA" Margin="0">
        <!-- 顶端返回按钮区域 -->
        <Grid VerticalAlignment="Top" Height="56" Background="#F5F7FA" >
            <Button Style="{StaticResource NEPageIconButtonStyle}" Click="rd_HomePage">
                <Path Data="M15,19L8,12L15,5" StrokeThickness="2.5" Stroke="#555" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Fill="Transparent"/>
            </Button>
        </Grid>

        <!-- 主要内容区域 -->
        <Grid Margin="32,72,32,80">
            <!-- 定义四行布局：标题、标签、内容、按钮 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 标题行自适应高度 -->
                <RowDefinition Height="Auto"/>  <!-- 标签行自适应高度 -->
                <RowDefinition Height="*"/>     <!-- 内容行占满剩余空间 -->
                <RowDefinition Height="Auto"/>  <!-- 按钮行自适应高度 -->
            </Grid.RowDefinitions>

            <!-- 标题输入区域 -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <TextBox x:Name="TitleTextBox"
                         Style="{StaticResource MinimalTextBox}"
                         FontSize="22"
                         FontWeight="Bold"
                         Foreground="#222"
                         TextChanged="TitleTextBox_TextChanged"
                         VerticalAlignment="Center"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- 标题占位符文本 -->
                <TextBlock x:Name="TitlePlaceholder"
                           Text="请输入标题..."
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#B0B0B0"
                           Margin="2,0,0,0"
                           IsHitTestVisible="False"
                           Visibility="Visible"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 标签输入和显示区域 -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 标签输入框 -->
                <Grid Grid.Row="0">
                    <TextBox x:Name="TagInputBox"
                             Style="{StaticResource MinimalTextBox}"
                             FontSize="14"
                             Foreground="#444"
                             TextChanged="TagInputBox_TextChanged"
                             KeyDown="TagInputBox_KeyDown"
                             Margin="0,0,0,8"
                             Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="TagPlaceholder"
                               Text="输入标签，按回车添加..."
                               FontSize="14"
                               Foreground="#B0B0B0"
                               Margin="2,0,0,0"
                               IsHitTestVisible="False"
                               Visibility="Visible"/>
                </Grid>

                <!-- 标签显示区域 -->
                <WrapPanel Grid.Row="1" x:Name="TagsPanel">
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagChipStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" 
                                                   Foreground="#444" 
                                                   Margin="0,0,4,0"/>
                                        <Button Grid.Column="1"
                                                Click="RemoveTag_Click"
                                                Tag="{Binding}"
                                                Style="{StaticResource MinimalButton}"
                                                Padding="4,0"
                                                Background="Transparent">
                                            <TextBlock Text="×" 
                                                       Foreground="#666" 
                                                       FontSize="16"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </Grid>

            <!-- 笔记内容输入区域 -->
            <Grid Grid.Row="2">
                <TextBox x:Name="ContentTextBox"
                         Style="{StaticResource MinimalTextBox}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="320"
                         Foreground="#444"
                         TextChanged="ContentTextBox_TextChanged"
                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- 内容占位符文本 -->
                <TextBlock x:Name="ContentPlaceholder"
                           Text="请输入内容..."
                           FontSize="16"
                           Foreground="#B0B0B0"
                           Padding="2,2,0,0"
                           IsHitTestVisible="False"
                           Visibility="Visible"/>
            </Grid>

            <!-- 底部按钮区域 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <!-- 删除按钮：仅在编辑模式下显示 -->
                <Button Style="{StaticResource MinimalButton}" 
                        Background="#FF4444"
                        Command="{Binding DeleteCommand}"
                        Margin="0,0,16,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    删除笔记
                </Button>
                <!-- 保存按钮：始终显示 -->
                <Button Style="{StaticResource MinimalButton}" 
                        Command="{Binding SaveCommand}">
                    保存笔记
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

