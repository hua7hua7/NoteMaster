<Page x:Class="NoteMaster.Views.Pages.TodoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NoteMaster.Utils"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="待办事项">
    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input Section -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox Text="{Binding NewTodoContent, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" 
                         Width="300" Margin="0,0,10,0" 
                         VerticalContentAlignment="Center" 
                         Height="30" 
                         KeyDown="TextBox_KeyDown"/>
                <DatePicker SelectedDate="{Binding NewTodoDueDate}" 
                            Width="150" Margin="0,0,10,0" 
                            VerticalContentAlignment="Center"/>
                <Button Content="添加" 
                        Command="{Binding AddTodoCommand}" 
                        Width="80" Height="30"/>
            </StackPanel>
        </StackPanel>

        <!-- Todo List -->
        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding TodoItems, FallbackValue={x:Null}}" 
                 BorderThickness="0" 
                 VirtualizingStackPanel.IsVirtualizing="False" 
                 d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Checkbox -->
                        <CheckBox IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged, FallbackValue=False}" 
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Content -->
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding Content, FallbackValue='未命名'}" 
                                   Foreground="{Binding DisplayTextColor, FallbackValue=Black}" 
                                   TextDecorations="{Binding DisplayTextDecorations}" 
                                   VerticalAlignment="Center" 
                                   FontSize="14"/>

                        <!-- Due Date -->
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding DueDate, StringFormat='截止: {0:yyyy-MM-dd}', FallbackValue=''}" 
                                   Visibility="{Binding DueDate.HasValue, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" 
                                   Margin="10,0" 
                                   VerticalAlignment="Center" 
                                   Foreground="Gray"/>

                        <!-- Reminder Toggle and Picker -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0">
                            <ToggleButton IsChecked="{Binding IsReminderSet, UpdateSourceTrigger=PropertyChanged, FallbackValue=False}" 
                                          Content="🔔" 
                                          Width="30" Height="30" 
                                          ToolTip="设置/取消提醒"/>
                            <DatePicker SelectedDate="{Binding ReminderAt, UpdateSourceTrigger=PropertyChanged}" 
                                        Visibility="{Binding IsReminderSet, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" 
                                        Width="150" Margin="5,0,0,0"/>
                        </StackPanel>

                        <!-- Delete Button -->
                        <Button Grid.Column="4" 
                                Content="删除" 
                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.DeleteTodoCommand}" 
                                CommandParameter="{Binding}" 
                                Width="60" Height="30" 
                                Margin="10,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>